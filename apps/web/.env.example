# Required: Supabase project (browser + server consume the public anon key).
# Local stack uses http://127.0.0.1:54421 via the devcontainer's compose-isolation
# shape (see kit/docs/guide/local-supabase-compose-isolation.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Sentry DSN for client-side error reporting. Empty disables.
NEXT_PUBLIC_SENTRY_DSN=

# Optional: PostHog project key for analytics. Empty disables.
NEXT_PUBLIC_POSTHOG_KEY=

# Required for /api/triage: Anthropic API key (server-only — NOT NEXT_PUBLIC_*).
# spec: specs/triage-route-handler/spec.md § Dependencies § Env vars.
ANTHROPIC_API_KEY=

# Optional: override the default triage system prompt without a redeploy.
# Vercel env vars cap at 4096 bytes; keep override ≤ 3500 chars (spec § Gotchas #3).
# Falls back to apps/web/app/api/triage/_lib/prompt.ts DEFAULT_TRIAGE_SYSTEM_PROMPT.
# TRIAGE_SYSTEM_PROMPT=

# Optional: override the default triage model. Falls back to claude-sonnet-4-6 (spec D1).
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: override the Anthropic API base URL. E2E tests use this to route to
# a local mock server (spec § Tests § E2E — test-seam option a).
# ANTHROPIC_BASE_URL=
